# VENDO Conecta · cabeceras de seguridad y caché (Cloudflare Pages)
# Nota: la vista /admin futura usará Google Identity Services; al habilitarla
# añadir https://accounts.google.com y https://apis.google.com a script-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.country.is; form-action 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400

/api/*
  Cache-Control: no-store
